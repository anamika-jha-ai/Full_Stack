<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Write New Chat</title>
</head>

<body>
  <h3>Write a new chat</h3>

  <!-- ✅ FORM MUST WRAP EVERYTHING -->
  <form action="/chats" method="POST">

    <input 
      type="text" 
      name="from" 
      placeholder="Who are you?" 
      required
    />
    <br><br>

    <textarea 
      name="message" 
      placeholder="Write a message here..."
    ></textarea>
    <br><br>

    <input 
      type="text" 
      name="to" 
      placeholder="Add receiver" 
      required
    />
    <br><br>

    <button type="submit">Create chat</button>

  </form>
</body>
</html>
